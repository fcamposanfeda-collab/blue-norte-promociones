# URL pública, sin barra final. En local puede quedarse en localhost.
# En el servidor, antes de construir: https://bluepromociones.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# El formulario envía a Web3Forms desde el navegador. La clave es pública por diseño del servicio.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# console escribe el mensaje en el servidor. resend lo envía por la API de Resend.
# El formulario de la web no usa estos dos: los deja el endpoint /api/contacto.
EMAIL_PROVIDER=console
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Solo el número, con prefijo de país, sin espacios. Si está vacío, el botón usa el teléfono de contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=34687512648

# Analítica y Search Console. GA4 no se carga hasta que la persona acepte cookies.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
