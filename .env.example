# URL pública, sin barra final. En local puede quedarse en localhost.
# En Vercel, si está vacía o es localhost, se usa el dominio de producción del proyecto.
# Cuando bluepromociones.com apunte a esta web, pon aquí https://bluepromociones.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# console escribe el mensaje en el servidor. resend lo envía por la API de Resend.
EMAIL_PROVIDER=console
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Solo el número, con prefijo de país, sin espacios. Si está vacío, el botón usa el teléfono de contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=34687512648

# Analítica y Search Console. GA4 no se carga hasta que la persona acepte cookies.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
